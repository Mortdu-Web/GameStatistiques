# --- Développement local ---
# Port d'écoute (conteneur ET hôte). Doit être différent de celui de game-hub.
PORT=25XXX
# Route racine de l'application, derrière le reverse proxy (mon-domaine.fr/statistiques/)
# Vide en local ; /statistiques en production (derrière le reverse proxy).
URL_PREFIX=
# Lien « Retour au Game Hub » dans la barre du haut (URL publique du hub). Vide = pas de lien.
HUB_URL=
# Rôles Keycloak autorisés à voir les statistiques, séparés par des virgules (ex. stats,admin).
# Vide = tout utilisateur connecté. Sans effet si AUTH_ENABLED=false.
STATS_ROLES=

# Base de données PostgreSQL : la MÊME que game-hub (lecture seule, ce service ne crée aucune table)
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=

# --- Auth (service séparé, paquet auth_client) ---
# false = pas d'authentification (dev local). true en production.
AUTH_ENABLED=false
# Auth, vu depuis le conteneur (réseau Docker "web")
AUTH_INTERNAL_URL=http://auth:25000/auth
# Auth, vu depuis le navigateur
AUTH_PUBLIC_URL=https://mon-domaine.fr/auth
# Derrière un reverse proxy / HTTPS
BEHIND_PROXY=false
